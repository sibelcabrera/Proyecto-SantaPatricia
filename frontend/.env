# ╔══════════════════════════════════════════════════════════════════╗
# ║  CONEXIÓN DEL FRONTEND CON EL BACKEND (Java + Servlets)           ║
# ╚══════════════════════════════════════════════════════════════════╝

# 🔌 URL base de la API (sin "/" al final).
#    El backend corre en GlassFish (puerto 8087) con el nombre "santapatricia".
VITE_API_URL=http://localhost:8087/santapatricia/api

# 🧪 Modo maqueta: true = datos inventados sin backend | false = usa el backend real
VITE_USE_MOCKS=false

# ⏱️ Tiempo máximo de espera por petición, en milisegundos.
VITE_API_TIMEOUT=10000
